         nits = pq_eotf(normalized)
     elif t in ("arib-std-b67", "hlg"):
-        nits = hlg_oetf_inverse(normalized) * 1000.0
+        # Scene light -> display light needs the OOTF, not a scale.
+        # L_W is an assumption; 1000 is the BT.2100 reference.
+        nits = hlg_ootf(hlg_oetf_inverse(normalized),
+                        metadata.get("hlg_peak_nits", 1000.0))
